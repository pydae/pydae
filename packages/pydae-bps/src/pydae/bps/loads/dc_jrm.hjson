// Data centre (Jiménez-Ruiz & Milano) in a small islanded two-machine system.
// DC: 300 MW of servers (150 MW CPU + 150 MW GPU) and 60 MW of cooling,
// as in the paper's case study (section IV-C).
{
system:{name:"dc_jrm", S_base:100e6, K_p_agc:0.0, K_i_agc:0.0, K_xif:0.0001},
agc:{gen:"1", K_p_agc:10.0, K_i_agc:2.0},
buses:[{name:"1", P_W:0.0, Q_var:0.0, U_kV:20.0},
       {name:"2", P_W:-3600e6, Q_var:-600e6, U_kV:400.0},
       {name:"3", P_W:0.0, Q_var:0.0, U_kV:400.0}
      ],
lines:[{bus_j:"1", bus_k:"2", X_pu:0.15, R_pu:0.0, Bs_pu:0.0, S_mva:2500},
       {bus_j:"2", bus_k:"3", X_pu:0.10, R_pu:0.01, Bs_pu:0.0, S_mva:2500},
       {bus_j:"1", bus_k:"3", X_pu:0.20, R_pu:0.02, Bs_pu:0.0, S_mva:2500}
      ],
syns:[
      {bus:"1", S_n:2500e6, K_delta:0.01,
        X_d:1.8, X1d:0.3, T1d0:8.0,
        X_q:1.7, X1q:0.55, T1q0:0.4,
        R_a:0.003, X_l:0.2,
        H:5.0, D:0.0,
        Omega_b:314.1592653589793, omega_s:1.0, K_sec:0.0,
        avr:{type:"sexs", K_a:200.0, T_a:1.0, T_b:10.0, T_e:0.05,
             E_min:-5, E_max:5, v_ref:1.0},
        gov:{type:"tgov1", R:0.05, T_1:0.5, V_max:1.2, V_min:0.0,
             T_2:2.1, T_3:7.0, D_t:0.0, p_c:0.8}
      },
      {bus:"2", S_n:2500e6, K_delta:0.0,
        X_d:1.8, X1d:0.3, T1d0:8.0,
        X_q:1.7, X1q:0.55, T1q0:0.4,
        R_a:0.003, X_l:0.2,
        H:5.0, D:0.0,
        Omega_b:314.1592653589793, omega_s:1.0, K_sec:0.0,
        avr:{type:"sexs", K_a:200.0, T_a:1.0, T_b:10.0, T_e:0.05,
             E_min:-5, E_max:5, v_ref:1.0},
        gov:{type:"tgov1", R:0.05, T_1:0.5, V_max:1.2, V_min:0.0,
             T_2:2.1, T_3:7.0, D_t:0.0, p_c:0.78},
        lc:{K_i:0.2, p_c_lc:0.78}
      }
     ],
loads:[
      {type:"dc_jrm", name:"dc", bus:"3", S_mva:400.0, F_n:50.0,
       // servers, eqs. (1)-(8): power at 0 % and 100 % utilisation
       p_cpu_0_mw:60.0,  p_cpu_100_mw:150.0, u_cpu:1.0, T_cpu:0.05,
       p_gpu_0_mw:30.0,  p_gpu_100_mw:150.0, u_gpu:1.0, T_gpu:0.05,
       // cooling: third-order induction motor (Milano 15.62-15.66), motor-base pu
       p_cool_mw:60.0, S_m_mva:75.0,
       r_s:0.031, x_s:0.1, x_r:0.18, x_mu:3.2, r_r:0.018, H_m:0.5,
       // miscellaneous ZIP load, eq. (10)
       p_zip_mw:5.0, q_zip_mvar:1.0, a_p:0.0, b_p:0.0, c_p:1.0, a_q:0.0, b_q:0.0, c_q:1.0,
       // UPS, eqs. (11)-(15): offline | online, losses, recharge power, storage
       topology:"offline", beta:0.0, p_chg_mw:20.0, e_max_s:300.0, K_e:1e-3
      }
     ],
faults:[{bus:"3"}]
}
